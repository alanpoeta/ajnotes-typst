{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Typst: New course",
            "detail": "Prompts for a title and language, then creates the course folder with course.typ and notes/main.typ.",
            "type": "shell",
            "command": "python3",
            "windows": {
                "command": "py"
            },
            "args": [
                "${userHome}/Projects/ajnotes/ajnotes-typst/scripts/_python.py",
                "new-course.py",
                "${input:courseTitle}",
                "--language",
                "${input:courseLanguage}"
            ],
            "options": {
                "env": {
                    "AJNOTES_ROOT": "${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "always",
                "close": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Typst: New lecture",
            "detail": "Adds the next lecture to the course of the file you're editing. Prompts for an optional title (leave blank for none).",
            "type": "shell",
            "command": "python3",
            "windows": {
                "command": "py"
            },
            "args": [
                "${userHome}/Projects/ajnotes/ajnotes-typst/scripts/_python.py",
                "new-lecture.py",
                "--from-file",
                "${file}",
                "--title=${input:lectureTitle}"
            ],
            "options": {
                "env": {
                    "AJNOTES_ROOT": "${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "always",
                "close": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Typst: Compile all courses",
            "detail": "Compiles every course's notes.",
            "type": "shell",
            "command": "python3",
            "windows": {
                "command": "py"
            },
            "args": [
                "${userHome}/Projects/ajnotes/ajnotes-typst/scripts/_python.py",
                "compile-all-courses.py"
            ],
            "options": {
                "env": {
                    "AJNOTES_ROOT": "${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "always",
                "close": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Typst: New exercise",
            "detail": "Prompts for a title, then creates a new exercises/ex_NN mini-project in the course of the file you're editing.",
            "type": "shell",
            "command": "python3",
            "windows": {
                "command": "py"
            },
            "args": [
                "${userHome}/Projects/ajnotes/ajnotes-typst/scripts/_python.py",
                "new-exercise.py",
                "--from-file",
                "${file}",
                "--title=${input:exerciseTitle}"
            ],
            "options": {
                "env": {
                    "AJNOTES_ROOT": "${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "always",
                "close": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Typst: New figure",
            "detail": "Prompts for a figure name, creates it in the project (notes or exercise) of the file you're editing, and opens Inkscape.",
            "type": "shell",
            "command": "python3",
            "windows": {
                "command": "py"
            },
            "args": [
                "${userHome}/Projects/ajnotes/ajnotes-typst/scripts/_python.py",
                "new-figure.py",
                "${input:figureName}",
                "--from-file",
                "${file}"
            ],
            "options": {
                "env": {
                    "AJNOTES_ROOT": "${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "silent",
                "close": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Typst: Edit figure",
            "detail": "Open an existing figure of the current project in Inkscape (lists figures if the name doesn't match).",
            "type": "shell",
            "command": "python3",
            "windows": {
                "command": "py"
            },
            "args": [
                "${userHome}/Projects/ajnotes/ajnotes-typst/scripts/_python.py",
                "edit-figure.py",
                "${input:figureName}",
                "--from-file",
                "${file}"
            ],
            "options": {
                "env": {
                    "AJNOTES_ROOT": "${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "silent",
                "close": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Typst: Watch figures",
            "detail": "Auto-export figure SVGs to PDF + Typst labels on save (run once per session).",
            "type": "shell",
            "command": "python3",
            "windows": {
                "command": "py"
            },
            "args": [
                "${userHome}/Projects/ajnotes/ajnotes-typst/scripts/_python.py",
                "watch-figures.py"
            ],
            "options": {
                "env": {
                    "AJNOTES_ROOT": "${workspaceFolder}"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "isBackground": true
        }
    ],
    "inputs": [
        {
            "id": "figureName",
            "type": "promptString",
            "description": "Figure name"
        },
        {
            "id": "exerciseTitle",
            "type": "promptString",
            "description": "Exercise title (optional, e.g. \"Sheet 1\")"
        },
        {
            "id": "lectureTitle",
            "type": "promptString",
            "description": "Lecture title (optional; leave blank for none)"
        },
        {
            "id": "courseTitle",
            "type": "promptString",
            "description": "Course title"
        },
        {
            "id": "courseLanguage",
            "type": "pickString",
            "description": "Course language",
            "options": [
                "english",
                "german"
            ],
            "default": "english"
        }
    ]
}
